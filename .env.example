# YouTube Data API v3 key used by the Chrome extension.
# Keep this value secret and restrict the key in Google Cloud Console.
YOUTUBE_API_KEY=replace_with_your_youtube_api_key

# Flask API settings.
API_URL=http://localhost:5000
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# MLflow settings used by evaluation and model registration.
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=dvc-pipeline-runs
MLFLOW_MODEL_NAME=my_model

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5000
